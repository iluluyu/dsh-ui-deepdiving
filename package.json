{
  "name": "dsh-ui-deepdiving",
  "version": "0.1.0",
  "description": "Curated effects and wording for the dsh web 'Deep diving…' turn status: six pure-CSS flowing-light presets (water flow default, stock sweep, breath, rainbow, pulse, aurora) with per-effect knobs, custom status wording, speed that follows generation, light/dark themes and reduced-motion respected.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "node --check lib/index.js && node --check lib/client.js",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iluluyu/dsh-ui-deepdiving.git"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=1.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deep-diving",
    "deepdiving",
    "animation",
    "effects",
    "water-flow",
    "shimmer"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
